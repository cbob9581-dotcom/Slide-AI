{
  "$schema": "https://raw.githubusercontent.com/nicegui/tauri-v2-docs/refs/heads/main/tauri.conf.json",
  "productName": "Slide AI",
  "version": "0.1.0",
  "identifier": "com.slideai.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Slide AI - 智能课件学习助手",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
